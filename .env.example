# Optional Hugging Face token for gated/private repositories.
HF_TOKEN=

# Keep caches inside the project only if desired. The default Hugging Face cache is otherwise used.
# HF_HOME=.cache/huggingface
# TRANSFORMERS_CACHE=.cache/huggingface/transformers

# Disable tokenizer subprocess warnings during training if needed.
TOKENIZERS_PARALLELISM=false

